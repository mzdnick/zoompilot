import importlib.util
from pathlib import Path

Import('env')

# The engine draws into the UI process's raylib context. raylib ships inside
# the python package (statically linked into the cffi extension), so the
# library is built with raylib symbols undefined and binds to the loader's
# instance at load time. Do not link raylib here.
raylib_dir = Path(importlib.util.find_spec("raylib").submodule_search_locations[0]) / "install"

engine_env = env.Clone()
# raylib symbols stay undefined on purpose; the global -Wl,--no-undefined forbids that
engine_env['LINKFLAGS'] = [f for f in engine_env['LINKFLAGS'] if f != '-Wl,--no-undefined']

engine_env['CPPPATH'] += [str(raylib_dir / "include"), "engine"]

src = Glob("engine/*.c")
screensaver_engine = engine_env.SharedLibrary("libinfinite_drive", src, LIBS=["m"])
Export('screensaver_engine')
